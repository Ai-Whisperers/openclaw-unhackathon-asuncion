# ============================================
# REQUIRED: Anthropic API (Claude)
# Get from: https://console.anthropic.com/
# ============================================
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ============================================
# REQUIRED: GitHub Integration
# Get from: https://github.com/settings/tokens
# Scopes needed: repo, workflow
# ============================================
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# ============================================
# REQUIRED FOR TESTING: Slack Bot
# Get from: https://api.slack.com/apps
# Scopes needed: chat:write, channels:read
# ============================================
SLACK_BOT_TOKEN=xoxb_YOUR_TOKEN_HERE
SLACK_SIGNING_SECRET=xxx_YOUR_SECRET_HERE
SLACK_CHANNEL_ID=C00000000

# ============================================
# OPTIONAL: Composio Integration
# Get from: https://app.composio.dev
# ============================================
COMPOSIO_API_KEY=YOUR_KEY_HERE

# ============================================
# OpenClaw Configuration
# ============================================
OPENCLAW_PORT=3000
OPENCLAW_HOST=localhost
OPENCLAW_AGENT_NAME=main

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/openclaw.log

# ============================================
# Environment
# ============================================
NODE_ENV=development

# ============================================
# Feature Flags (for testing)
# ============================================
FEATURE_SLACK_PARSER=true
FEATURE_GITHUB_FORMATTER=true
FEATURE_COMPOSIO_INTEGRATION=true
