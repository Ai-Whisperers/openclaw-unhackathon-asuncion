{
  "name": "openclaw-unhackathon-asuncion",
  "version": "1.0.0",
  "description": "OpenClaw Unhackathon 2026 - Slack to GitHub Integration",
  "main": "src/agent.js",
  "type": "module",
  "scripts": {
    "start": "node src/agent.js",
    "dev": "NODE_ENV=development node src/agent.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.test.js'",
    "test:e2e": "node --test 'tests/e2e/**/*.test.js'",
    "test:coverage": "node --test --coverage 'tests/**/*.test.js'",
    "test:skills": "node src/skills/parse-slack-message.js --test && node src/skills/format-github-issue.js --test",
    "setup": "bash scripts/setup.sh",
    "demo": "bash scripts/demo.sh",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src tests",
    "clean": "rm -rf node_modules package-lock.json logs/*"
  },
  "keywords": [
    "openclaw",
    "agent",
    "ai",
    "slack",
    "github",
    "automation",
    "composio"
  ],
  "author": "You",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@composio/sdk": "^0.16.0",
    "@modelcontextprotocol/sdk": "^0.4.0",
    "dotenv": "^16.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "c8": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
